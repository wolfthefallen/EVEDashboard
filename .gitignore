.DS_Store

# Internal working docs - never published to the public repo. The entire plans/ folder
# (plan files + TODO/BUGS/CLEANUP trackers) and the AI/contributor operating contract
# stay local-only.
plans/
CLAUDE.md

# Claude Code local config (personal settings + runtime lock; not shared).
.claude/

# Local-only notes (e.g. ESI app registration / secrets); never committed or published.
*.local.md

# Local-only developer tools (NOT shipped, NOT published). Currently holds the SQLite
# CLI binaries (sqlite3.exe etc.) kept here for Claude/AI to read the runtime SQLite
# stores (session.sqlite, sde.sqlite) read-only when troubleshooting live bugs. See
# tools/README.md.
tools/

# Google Drive sync staging. The repo folder is backed up to Drive, which parks
# partial uploads here mid-sync; they are not project files and a `git add -A`
# would otherwise sweep hundreds of them into a commit.
.tmp.driveupload/
