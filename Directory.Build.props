<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <LangVersion>latest</LangVersion>
    <!-- App version (plan 41). SemVer; matches the git release tag v<Version>.
         Bump on the release topic branch before tagging. Read at runtime by the
         launch update check to compare against the latest GitHub release. -->
    <Version>0.1.1</Version>
  </PropertyGroup>
</Project>
