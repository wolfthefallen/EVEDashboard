<Window x:Class="EveDashboard.App.Wpf.CrystalDiagramWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Crystal Diagram"
        ResizeMode="CanResize"
        Background="{DynamicResource BackgroundBrush}">
    <!--
        Plan 35: Row 0 holds the anomaly-picker ComboBox; Row 1 holds the
        Image. ItemsSource = VM.Entries; SelectedItem two-way bound to
        VM.SelectedEntry; the Image's Source binds to the selected entry's
        ImagePackUri so swapping the dropdown selection updates the image
        on the WPF binding loop.

        Initial size + position come from WindowGeometryService (default
        900x650 centered on first launch; persisted thereafter via
        crystal_diagram_window_geometry — Bug 1). Stretch="Uniform" makes
        the Image scale proportionally inside the row's allocated area on
        every resize (drag-resize AND FancyZones snap-resize).
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ComboBox Grid.Row="0"
                  Margin="6,6,6,4"
                  ItemsSource="{Binding Entries}"
                  SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                  DisplayMemberPath="DisplayName" />

        <Image Grid.Row="1"
               Source="{Binding SelectedEntry.ImagePackUri}"
               Stretch="Uniform"
               StretchDirection="Both" />
    </Grid>
</Window>
