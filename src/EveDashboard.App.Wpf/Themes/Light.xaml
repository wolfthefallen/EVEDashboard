<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Light theme. Keys mirror Themes/Dark.xaml exactly so the theme swap
        (ThemeService, fired from the Settings dialog) is a one-dictionary-replace
        operation.

        Palette (user-supplied 2026-05-03):
          background      #F4F6F9    soft neutral page background
          panel_secondary #FFFFFF    clean surfaces
          card_background #FFFFFF    elevated surfaces (widget interior, buttons)
          primary_accent  #485DFF    brand accent
          primary_font    #1F2328    strong readable text
          secondary_font  #5F6672    muted text
          light_blue      #0EA5E9
          mint_green      #3ECF9E    also status_ok
          coral_pink      #E85D70    also status_error
          border_color    #E3E6EB
          divider_color   #EEF1F4
          hover_overlay   rgba(0,0,0,0.04) becomes #0A000000
          active_overlay  rgba(0,0,0,0.08) becomes #14000000
          focus_ring      rgba(72,93,255,0.35) becomes #59485DFF
        card_shadow / modal_shadow are CSS box-shadow constructs; in WPF
        these are DropShadowEffect resources, not brushes; out of scope here.
    -->

    <!-- Existing keys (consumed by current XAML) -->
    <Color x:Key="BackgroundColor">#FFF4F6F9</Color>
    <Color x:Key="ForegroundColor">#FF1F2328</Color>
    <Color x:Key="BorderColor">#FFE3E6EB</Color>
    <Color x:Key="WidgetBackgroundColor">#FFFFFFFF</Color>
    <Color x:Key="WidgetBorderColor">#FFEEF1F4</Color>
    <Color x:Key="ButtonBackgroundColor">#FFFFFFFF</Color>
    <Color x:Key="ButtonForegroundColor">#FF1F2328</Color>
    <Color x:Key="ButtonHoverColor">#FFE3E6EB</Color>
    <Color x:Key="AccentColor">#FF485DFF</Color>

    <!-- New palette additions (no current consumers; reserved for future widgets) -->
    <Color x:Key="PanelSecondaryColor">#FFFFFFFF</Color>
    <Color x:Key="SecondaryFontColor">#FF5F6672</Color>
    <Color x:Key="LightBlueColor">#FF0EA5E9</Color>
    <Color x:Key="MintGreenColor">#FF3ECF9E</Color>
    <Color x:Key="CoralPinkColor">#FFE85D70</Color>
    <Color x:Key="StatusOkColor">#FF3ECF9E</Color>
    <Color x:Key="StatusErrorColor">#FFE85D70</Color>
    <Color x:Key="HoverOverlayColor">#0A000000</Color>
    <Color x:Key="ActiveOverlayColor">#14000000</Color>
    <Color x:Key="FocusRingColor">#59485DFF</Color>

    <SolidColorBrush x:Key="BackgroundBrush"        Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="ForegroundBrush"        Color="{StaticResource ForegroundColor}" />
    <SolidColorBrush x:Key="BorderBrush"            Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="WidgetBackgroundBrush"  Color="{StaticResource WidgetBackgroundColor}" />
    <SolidColorBrush x:Key="WidgetBorderBrush"      Color="{StaticResource WidgetBorderColor}" />
    <SolidColorBrush x:Key="ButtonBackgroundBrush"  Color="{StaticResource ButtonBackgroundColor}" />
    <SolidColorBrush x:Key="ButtonForegroundBrush"  Color="{StaticResource ButtonForegroundColor}" />
    <SolidColorBrush x:Key="ButtonHoverBrush"       Color="{StaticResource ButtonHoverColor}" />
    <SolidColorBrush x:Key="AccentBrush"            Color="{StaticResource AccentColor}" />

    <SolidColorBrush x:Key="PanelSecondaryBrush"    Color="{StaticResource PanelSecondaryColor}" />
    <SolidColorBrush x:Key="SecondaryFontBrush"     Color="{StaticResource SecondaryFontColor}" />
    <SolidColorBrush x:Key="LightBlueBrush"         Color="{StaticResource LightBlueColor}" />
    <SolidColorBrush x:Key="MintGreenBrush"         Color="{StaticResource MintGreenColor}" />
    <SolidColorBrush x:Key="CoralPinkBrush"         Color="{StaticResource CoralPinkColor}" />
    <SolidColorBrush x:Key="StatusOkBrush"          Color="{StaticResource StatusOkColor}" />
    <SolidColorBrush x:Key="StatusErrorBrush"       Color="{StaticResource StatusErrorColor}" />
    <SolidColorBrush x:Key="HoverOverlayBrush"      Color="{StaticResource HoverOverlayColor}" />
    <SolidColorBrush x:Key="ActiveOverlayBrush"     Color="{StaticResource ActiveOverlayColor}" />
    <SolidColorBrush x:Key="FocusRingBrush"         Color="{StaticResource FocusRingColor}" />

    <!--
        Elevation effects (palette: card_shadow / modal_shadow).
        Approximated from CSS box-shadow: BlurRadius = CSS blur, ShadowDepth =
        CSS y-offset, Opacity = CSS rgba alpha. Direction = 270 (downward).
    -->
    <DropShadowEffect x:Key="CardShadowEffect"
                      Color="Black"
                      BlurRadius="8"
                      ShadowDepth="2"
                      Direction="270"
                      Opacity="0.06" />
    <DropShadowEffect x:Key="ModalShadowEffect"
                      Color="Black"
                      BlurRadius="24"
                      ShadowDepth="8"
                      Direction="270"
                      Opacity="0.12" />

</ResourceDictionary>
