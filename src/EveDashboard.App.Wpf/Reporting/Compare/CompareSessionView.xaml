<widgets:WidgetBase x:Class="EveDashboard.App.Wpf.Reporting.Compare.CompareSessionView"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:widgets="clr-namespace:EveDashboard.App.Wpf.Widgets"
                    mc:Ignorable="d">
    <!--
        Plan 36: the single compare-mode widget. Replaces the prior
        CompareSessionStatsView + ComparePerOreBreakdownView + per-pilot stack
        with one stacked subheader and two static-column DataGrids.
    -->
    <StackPanel Orientation="Vertical">
        <TextBlock Text="Comparing sessions:"
                   FontWeight="Bold"
                   Margin="0,0,0,2"
                   Foreground="{DynamicResource ForegroundBrush}" />
        <ItemsControl ItemsSource="{Binding SessionNames}" Margin="0,0,0,8">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}"
                               Margin="12,0,0,0"
                               Foreground="{DynamicResource ForegroundBrush}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Plan 45 (decision 1.1 = C): grand-total labels + Total Refined Output
             table, shown ABOVE the Cumulative / Rates tables. -->
        <TextBlock Text="{Binding TotalTimeDisplay, StringFormat='TOTAL TIME:  {0}'}"
                   FontWeight="Bold"
                   FontSize="14"
                   Margin="0,4,0,0"
                   Foreground="{DynamicResource ForegroundBrush}" />
        <TextBlock Text="{Binding TotalIskDisplay, StringFormat='TOTAL ISK:  {0}'}"
                   FontWeight="Bold"
                   FontSize="14"
                   Margin="0,0,0,8"
                   Foreground="{DynamicResource ForegroundBrush}" />

        <TextBlock Text="Total Refined Output"
                   FontWeight="SemiBold"
                   Margin="0,0,0,2"
                   Foreground="{DynamicResource ForegroundBrush}" />

        <DataGrid x:Name="RefinedGrid"
                  ItemsSource="{Binding RefinedRows}"
                  AutoGenerateColumns="False"
                  CanUserSortColumns="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserReorderColumns="False"
                  CanUserResizeRows="False"
                  IsReadOnly="True"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  Background="Transparent"
                  Foreground="{DynamicResource ForegroundBrush}"
                  RowBackground="Transparent"
                  AlternatingRowBackground="{DynamicResource HoverOverlayBrush}"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Disabled"
                  Margin="0,0,0,8"
                  PreviewMouseWheel="CompareGrid_PreviewMouseWheel">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Material"
                                    Binding="{Binding Material}"
                                    Width="*"
                                    SortMemberPath="Material" />
                <DataGridTextColumn Header="Quantity"
                                    Binding="{Binding Quantity, StringFormat=N0}"
                                    Width="Auto"
                                    SortMemberPath="Quantity">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right" />
                            <Setter Property="Margin" Value="0,0,8,0" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Total ISK"
                                    Binding="{Binding Isk, StringFormat=N0}"
                                    Width="Auto"
                                    SortMemberPath="Isk">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right" />
                            <Setter Property="Margin" Value="0,0,8,0" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Text="Cumulative"
                   FontWeight="SemiBold"
                   Margin="0,0,0,2"
                   Foreground="{DynamicResource ForegroundBrush}" />

        <DataGrid x:Name="CumulativeGrid"
                  ItemsSource="{Binding CumulativeRows}"
                  AutoGenerateColumns="False"
                  CanUserSortColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserReorderColumns="False"
                  CanUserResizeRows="False"
                  IsReadOnly="True"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  Background="Transparent"
                  Foreground="{DynamicResource ForegroundBrush}"
                  RowBackground="Transparent"
                  AlternatingRowBackground="{DynamicResource HoverOverlayBrush}"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Disabled"
                  PreviewMouseWheel="CompareGrid_PreviewMouseWheel">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Stat"  Binding="{Binding Label}" Width="*" />
                <DataGridTextColumn Header="Avg"   Binding="{Binding Avg}"   Width="Auto" />
                <DataGridTextColumn Header="Total" Binding="{Binding Total}" Width="Auto" />
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Text="Rates"
                   FontWeight="SemiBold"
                   Margin="0,8,0,2"
                   Foreground="{DynamicResource ForegroundBrush}" />

        <DataGrid x:Name="RatesGrid"
                  ItemsSource="{Binding RateRows}"
                  AutoGenerateColumns="False"
                  CanUserSortColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserReorderColumns="False"
                  CanUserResizeRows="False"
                  IsReadOnly="True"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  Background="Transparent"
                  Foreground="{DynamicResource ForegroundBrush}"
                  RowBackground="Transparent"
                  AlternatingRowBackground="{DynamicResource HoverOverlayBrush}"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Disabled"
                  PreviewMouseWheel="CompareGrid_PreviewMouseWheel">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Stat" Binding="{Binding Label}" Width="*" />
                <DataGridTextColumn Header="Avg"  Binding="{Binding Avg}"   Width="Auto" />
            </DataGrid.Columns>
        </DataGrid>
    </StackPanel>
</widgets:WidgetBase>
