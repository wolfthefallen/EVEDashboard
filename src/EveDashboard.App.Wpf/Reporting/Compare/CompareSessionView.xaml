<widgets:WidgetBase x:Class="EveDashboard.App.Wpf.Reporting.Compare.CompareSessionView"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:widgets="clr-namespace:EveDashboard.App.Wpf.Widgets"
                    mc:Ignorable="d">
    <!--
        Plan 36: the single compare-mode widget. Replaces the prior
        CompareSessionStatsView + ComparePerOreBreakdownView + per-pilot stack
        with one stacked subheader and two static-column DataGrids.
    -->
    <StackPanel Orientation="Vertical">
        <TextBlock Text="Comparing sessions:"
                   FontWeight="Bold"
                   Margin="0,0,0,2"
                   Foreground="{DynamicResource ForegroundBrush}" />
        <ItemsControl ItemsSource="{Binding SessionNames}" Margin="0,0,0,8">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}"
                               Margin="12,0,0,0"
                               Foreground="{DynamicResource ForegroundBrush}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="Cumulative"
                   FontWeight="SemiBold"
                   Margin="0,0,0,2"
                   Foreground="{DynamicResource ForegroundBrush}" />

        <DataGrid x:Name="CumulativeGrid"
                  ItemsSource="{Binding CumulativeRows}"
                  AutoGenerateColumns="False"
                  CanUserSortColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserReorderColumns="False"
                  CanUserResizeRows="False"
                  IsReadOnly="True"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  Background="Transparent"
                  Foreground="{DynamicResource ForegroundBrush}"
                  RowBackground="Transparent"
                  AlternatingRowBackground="{DynamicResource HoverOverlayBrush}"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Disabled"
                  PreviewMouseWheel="CompareGrid_PreviewMouseWheel">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Stat"  Binding="{Binding Label}" Width="*" />
                <DataGridTextColumn Header="Avg"   Binding="{Binding Avg}"   Width="Auto" />
                <DataGridTextColumn Header="Total" Binding="{Binding Total}" Width="Auto" />
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Text="Rates"
                   FontWeight="SemiBold"
                   Margin="0,8,0,2"
                   Foreground="{DynamicResource ForegroundBrush}" />

        <DataGrid x:Name="RatesGrid"
                  ItemsSource="{Binding RateRows}"
                  AutoGenerateColumns="False"
                  CanUserSortColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserReorderColumns="False"
                  CanUserResizeRows="False"
                  IsReadOnly="True"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  Background="Transparent"
                  Foreground="{DynamicResource ForegroundBrush}"
                  RowBackground="Transparent"
                  AlternatingRowBackground="{DynamicResource HoverOverlayBrush}"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Disabled"
                  PreviewMouseWheel="CompareGrid_PreviewMouseWheel">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Stat" Binding="{Binding Label}" Width="*" />
                <DataGridTextColumn Header="Avg"  Binding="{Binding Avg}"   Width="Auto" />
            </DataGrid.Columns>
        </DataGrid>
    </StackPanel>
</widgets:WidgetBase>
