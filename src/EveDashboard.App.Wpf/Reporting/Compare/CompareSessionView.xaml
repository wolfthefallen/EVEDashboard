<widgets:WidgetBase x:Class="EveDashboard.App.Wpf.Reporting.Compare.CompareSessionView"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:widgets="clr-namespace:EveDashboard.App.Wpf.Widgets"
                    mc:Ignorable="d">
    <!--
        The single compare-mode widget: one stacked session-name subheader,
        grand-total labels, and three static-column DataGrids (Total Refined
        Output / Cumulative / Rates). No per-pilot stack, no per-ore tables.
    -->
    <StackPanel Orientation="Vertical">
        <TextBlock Text="Comparing sessions:"
                   Tag="{Binding [Header]}"
                   Style="{StaticResource ReportsEmphasisLabel}"
                   Margin="0,0,0,2" />
        <ItemsControl ItemsSource="{Binding SessionNames}" Margin="0,0,0,8">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}"
                               Margin="12,0,0,0"
                               Foreground="{DynamicResource ForegroundBrush}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Grand-total labels + Total Refined Output table, shown ABOVE the
             Cumulative / Rates tables. -->
        <TextBlock Text="{Binding TotalTimeDisplay, StringFormat='TOTAL TIME:  {0}'}"
                   Tag="{Binding [TotalTime]}"
                   Style="{StaticResource ReportsEmphasisLabel}"
                   Margin="0,4,0,0" />
        <TextBlock Text="{Binding TotalIskDisplay, StringFormat='TOTAL ISK:  {0}'}"
                   Tag="{Binding [TotalIsk]}"
                   Style="{StaticResource ReportsEmphasisLabel}"
                   Margin="0,0,0,8" />

        <TextBlock Text="Total Refined Output"
                   Tag="{Binding [RefinedLabel]}"
                   Style="{StaticResource ReportsEmphasisLabel}"
                   Margin="0,0,0,2" />

        <DataGrid x:Name="RefinedGrid"
                  ItemsSource="{Binding RefinedRows}"
                  FontSize="{Binding [RefinedTable], Converter={StaticResource EmphasisToFontSize}}"
                  AutoGenerateColumns="False"
                  CanUserSortColumns="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserReorderColumns="False"
                  CanUserResizeRows="False"
                  IsReadOnly="True"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  Background="Transparent"
                  Foreground="{DynamicResource ForegroundBrush}"
                  RowBackground="Transparent"
                  AlternatingRowBackground="{DynamicResource HoverOverlayBrush}"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Disabled"
                  Margin="0,0,0,8"
                  PreviewMouseWheel="CompareGrid_PreviewMouseWheel">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Material"
                                    Binding="{Binding Material}"
                                    Width="*"
                                    SortMemberPath="Material" />
                <DataGridTextColumn Header="Quantity"
                                    Binding="{Binding Quantity, StringFormat=N0}"
                                    Width="Auto"
                                    SortMemberPath="Quantity">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Left" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Total ISK"
                                    Binding="{Binding Isk, StringFormat=N0}"
                                    Width="Auto"
                                    SortMemberPath="Isk">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Left" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Text="Cumulative"
                   Tag="{Binding [CumulativeLabel]}"
                   Style="{StaticResource ReportsEmphasisLabel}"
                   Margin="0,0,0,2" />

        <DataGrid x:Name="CumulativeGrid"
                  ItemsSource="{Binding CumulativeRows}"
                  FontSize="{Binding [CumulativeTable], Converter={StaticResource EmphasisToFontSize}}"
                  AutoGenerateColumns="False"
                  CanUserSortColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserReorderColumns="False"
                  CanUserResizeRows="False"
                  IsReadOnly="True"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  Background="Transparent"
                  Foreground="{DynamicResource ForegroundBrush}"
                  RowBackground="Transparent"
                  AlternatingRowBackground="{DynamicResource HoverOverlayBrush}"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Disabled"
                  PreviewMouseWheel="CompareGrid_PreviewMouseWheel">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Stat"  Binding="{Binding Label}" Width="*" />
                <DataGridTextColumn Header="Avg"   Binding="{Binding Avg}"   Width="Auto" />
                <DataGridTextColumn Header="Total" Binding="{Binding Total}" Width="Auto" />
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Text="Rates"
                   Tag="{Binding [RatesLabel]}"
                   Style="{StaticResource ReportsEmphasisLabel}"
                   Margin="0,8,0,2" />

        <DataGrid x:Name="RatesGrid"
                  ItemsSource="{Binding RateRows}"
                  FontSize="{Binding [RatesTable], Converter={StaticResource EmphasisToFontSize}}"
                  AutoGenerateColumns="False"
                  CanUserSortColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserReorderColumns="False"
                  CanUserResizeRows="False"
                  IsReadOnly="True"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  Background="Transparent"
                  Foreground="{DynamicResource ForegroundBrush}"
                  RowBackground="Transparent"
                  AlternatingRowBackground="{DynamicResource HoverOverlayBrush}"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Disabled"
                  PreviewMouseWheel="CompareGrid_PreviewMouseWheel">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Stat" Binding="{Binding Label}" Width="*" />
                <DataGridTextColumn Header="Avg"  Binding="{Binding Avg}"   Width="Auto" />
            </DataGrid.Columns>
        </DataGrid>
    </StackPanel>
</widgets:WidgetBase>
