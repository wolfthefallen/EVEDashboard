<Window x:Class="EveDashboard.App.Wpf.Reporting.ReportsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:reporting="clr-namespace:EveDashboard.App.Wpf.Reporting"
        xmlns:reportingWidgets="clr-namespace:EveDashboard.App.Wpf.Reporting.Widgets"
        xmlns:compare="clr-namespace:EveDashboard.App.Wpf.Reporting.Compare"
        xmlns:session="clr-namespace:EveDashboard.App.Wpf.Widgets.Session"
        xmlns:pilot="clr-namespace:EveDashboard.App.Wpf.Widgets.Pilot"
        xmlns:statconfig="clr-namespace:EveDashboard.App.Wpf.Widgets.StatConfig"
        xmlns:converters="clr-namespace:EveDashboard.App.Wpf.Converters"
        mc:Ignorable="d"
        Title="Reports - EVE Dashboard"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}">
    <!--
        Reports child window. Modeless (parent calls Window.Show); not
        Topmost; not transparent. A separate child window from MainWindow so
        the user can keep mining while reviewing reports. Three-column layout:
        a resizable left sidebar of saved sessions (sortable DataGrid), a
        GridSplitter, and a scrollable breakdown content pane on the right.
        The breakdown content uses one PerOreBreakdown widget reused at
        session-level and per-pilot-level.
    -->
    <Window.Resources>
        <!-- Loading-spinner visibility toggles. Key names match the
             convention used in Dialogs/SettingsDialog.xaml. The inverse one
             is the same converter the Settings dialog's bootstrap-failure
             mode uses to hide the Display/Pricing/Markets sections. -->
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
        <!-- Empty status string -> collapsed status row. -->
        <converters:StringEmptyToVisibilityConverter x:Key="StringEmptyToVisibility" />
        <!-- BreakdownContentMode -> Visibility (matches converter parameter against the bound mode). -->
        <converters:BreakdownContentModeToVisibilityConverter x:Key="ModeToVisibility" />

        <!-- Implicit DataTemplates: when an ItemsControl carries one of these
             VMs, WPF picks the matching View. The saved-data sibling VMs are
             distinct types from the live VMs so the templates are explicit
             per type. -->
        <DataTemplate DataType="{x:Type session:SavedSessionStatsViewModel}">
            <session:SessionStatsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type pilot:SavedPerPilotWidgetViewModel}">
            <pilot:PerPilotWidgetView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type reportingWidgets:PerOreBreakdownViewModel}">
            <reportingWidgets:PerOreBreakdownView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type reportingWidgets:PerRefinedBreakdownViewModel}">
            <reportingWidgets:PerRefinedBreakdownView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type reporting:PerPilotEntry}">
            <StackPanel Orientation="Vertical" Margin="0,0,0,12">
                <ContentPresenter Content="{Binding Pilot}" />
                <ContentPresenter Content="{Binding Ore}" Margin="0,4,0,0" />
                <ContentPresenter Content="{Binding Refined}" Margin="0,4,0,0" />
            </StackPanel>
        </DataTemplate>

        <!-- Compare-mode VM <-> View pairing: a single decluttered widget
             (no per-pilot or per-ore templates in compare mode). -->
        <DataTemplate DataType="{x:Type compare:CompareSessionViewModel}">
            <compare:CompareSessionView />
        </DataTemplate>

        <!-- The table widgets' chrome "text size" Popup resolves its content
             (TextSizePopupViewModel) through this implicit template. The chrome lives in
             the app-wide Generic.xaml, but the popup VM->View mapping is per-window (the
             stat-config equivalent lives in MainWindow.xaml), so the Reports table widgets
             need their own copy here. -->
        <DataTemplate DataType="{x:Type statconfig:TextSizePopupViewModel}">
            <statconfig:TextSizePopupView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <!-- Outer 3-row layout. Row 0 = chrome strip with the Import Session /
             Lifetime Totals buttons. Row 1 = the 3-column content grid. Row 2 =
             the one-line status surface. The status row collapses when
             StatusMessage is empty. -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Margin="8,4"
                    Background="{DynamicResource BackgroundBrush}">
            <Button Content="Import Session..."
                    Command="{Binding ImportSessionCommand}"
                    Padding="10,3"
                    Margin="0,0,8,0" />
            <Button Content="Lifetime Totals"
                    Command="{Binding ShowLifetimeTotalsCommand}"
                    Padding="10,3"
                    Margin="0,0,8,0" />
            <Button Content="Build from history..."
                    Command="{Binding BuildFromHistoryCommand}"
                    ToolTip="Create a session from a past date/time window by reading the gamelogs"
                    Padding="10,3"
                    Margin="0,0,8,0" />
        </StackPanel>

        <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="{Binding Sidebar.ExpandedWidth, Mode=OneWay}" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{DynamicResource BackgroundBrush}"
                BorderBrush="{DynamicResource WidgetBorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="6,6,6,4" LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left"
                               Text="Saved sessions"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource ForegroundBrush}" />
                    <CheckBox DockPanel.Dock="Right"
                              Content="Show archived"
                              IsChecked="{Binding Sidebar.ShowArchived, Mode=TwoWay}"
                              ToolTip="Also list the sessions that were combined into another session"
                              VerticalAlignment="Center"
                              Foreground="{DynamicResource ForegroundBrush}" />
                </DockPanel>

                <DataGrid Grid.Row="1"
                          x:Name="SessionsGrid"
                          ItemsSource="{Binding Sidebar.Rows}"
                          AutoGenerateColumns="False"
                          CanUserSortColumns="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserReorderColumns="False"
                          IsReadOnly="True"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          Background="Transparent"
                          Foreground="{DynamicResource ForegroundBrush}"
                          RowBackground="Transparent"
                          AlternatingRowBackground="{DynamicResource HoverOverlayBrush}"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                    <DataGrid.RowStyle>
                        <!-- Per-row ContextMenu carrying Export to JSON / Excel / Delete.
                             ElementName binding stashes the DataGrid's DataContext (= ReportsWindowViewModel)
                             on each row's Tag so the menu can reach Sidebar.ExportXxxCommand
                             via PlacementTarget.Tag (ContextMenu sits outside the visual tree,
                             so AncestorType=DataGrid does not work; PlacementTarget is the row). -->
                        <Style TargetType="DataGridRow">
                            <Setter Property="Tag"
                                    Value="{Binding DataContext, ElementName=SessionsGrid}" />
                            <Setter Property="ContextMenu">
                                <Setter.Value>
                                    <ContextMenu>
                                        <MenuItem
                                            Header="Export to JSON..."
                                            Command="{Binding PlacementTarget.Tag.Sidebar.ExportJsonCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                            CommandParameter="{Binding PlacementTarget.DataContext.Data, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        <MenuItem
                                            Header="Export to Excel..."
                                            Command="{Binding PlacementTarget.Tag.Sidebar.ExportExcelCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                            CommandParameter="{Binding PlacementTarget.DataContext.Data, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        <MenuItem
                                            Header="Combine selected..."
                                            ToolTip="Combine the ticked sessions (two or more) into one new session"
                                            Command="{Binding PlacementTarget.Tag.CombineSelectedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        <Separator />
                                        <MenuItem
                                            Header="Delete..."
                                            Command="{Binding PlacementTarget.Tag.Sidebar.DeleteSessionCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                            CommandParameter="{Binding PlacementTarget.DataContext.Data, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    </ContextMenu>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <!-- Checkbox column drives compare-mode selection.
                             TemplateColumn (not DataGridCheckBoxColumn) so it
                             toggles on first click without needing edit-mode
                             plumbing. -->
                        <DataGridTemplateColumn Header="" Width="Auto" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Name"
                                            Binding="{Binding DisplayName}"
                                            Width="*"
                                            SortMemberPath="Name" />
                        <DataGridTextColumn Header="Start"
                                            Binding="{Binding StartTime, StringFormat=yyyy-MM-dd HH:mm}"
                                            Width="Auto"
                                            SortMemberPath="StartTime" />
                        <DataGridTextColumn Header="Duration"
                                            Binding="{Binding ActiveDuration, StringFormat=hh\\:mm\\:ss}"
                                            Width="Auto"
                                            SortMemberPath="ActiveDuration" />
                        <DataGridTextColumn Header="Pilots"
                                            Binding="{Binding PilotCount}"
                                            Width="Auto"
                                            SortMemberPath="PilotCount" />
                        <DataGridTextColumn Header="Total ISK"
                                            Binding="{Binding TotalIskMined, StringFormat=N0}"
                                            Width="Auto"
                                            SortMemberPath="TotalIskMined" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <GridSplitter Grid.Column="1"
                      Width="4"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Background="{DynamicResource WidgetBorderBrush}"
                      DragCompleted="SidebarGridSplitter_DragCompleted" />

        <ScrollViewer Grid.Column="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="8">
            <!-- Spinner subtree + widget-wrapper subtree, both
                 visibility-toggled by Content.IsLoading. Inside the wrapper,
                 the Single/Compare Mode toggle selects the content. -->
            <Grid>
                <!-- Loading spinner: visible only while a LoadAsync is in flight.
                     Render-thread-animated orbital spinner — the animation is
                     immune to UI-dispatcher saturation, so it keeps spinning
                     smoothly even during the heavy binding-update cascade at
                     the end of a load. -->
                <ContentControl
                    Visibility="{Binding Content.IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch">
                    <reporting:OrbitalSpinner
                        Width="240" Height="240"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
                </ContentControl>

                <!-- Widget subtrees: hidden while loading; otherwise the inner
                     StackPanels toggle on Content.Mode as today. -->
                <Grid Visibility="{Binding Content.IsLoading, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <!-- Single mode: 1 session selected. -->
                    <StackPanel Orientation="Vertical"
                                Visibility="{Binding Content.Mode, Converter={StaticResource ModeToVisibility}, ConverterParameter=Single}">
                        <ContentPresenter Content="{Binding Content.SessionStats}" />
                        <ContentPresenter Content="{Binding Content.SessionOreBreakdown}" Margin="0,8,0,0" />
                        <ContentPresenter Content="{Binding Content.SessionRefinedBreakdown}" Margin="0,8,0,0" />
                        <ItemsControl ItemsSource="{Binding Content.PerPilotEntries}" Margin="0,12,0,0" />
                    </StackPanel>
                    <!-- Compare mode: 2+ sessions selected. A single
                         compare widget; no per-pilot stack, no per-ore tables. -->
                    <StackPanel Orientation="Vertical"
                                Visibility="{Binding Content.Mode, Converter={StaticResource ModeToVisibility}, ConverterParameter=Compare}">
                        <ContentPresenter Content="{Binding Content.CompareSession}" />
                    </StackPanel>
                    <!-- Empty selection leaves the pane blank (Single mode,
                         all nulls). The all-time rollup lives in its own window
                         (the "Lifetime Totals" chrome button). -->
                </Grid>
            </Grid>
        </ScrollViewer>
        </Grid>

        <!-- Status row. Reads "Imported: ..." / "Exported: ..." /
             "Import failed: ..." after a sidebar-driven action. Empty string =>
             collapsed (zero layout space). -->
        <TextBlock Grid.Row="2"
                   Text="{Binding StatusMessage}"
                   Visibility="{Binding StatusMessage, Converter={StaticResource StringEmptyToVisibility}}"
                   TextTrimming="CharacterEllipsis"
                   Margin="8,4"
                   Foreground="{DynamicResource ForegroundBrush}"
                   Background="{DynamicResource BackgroundBrush}" />
    </Grid>
</Window>
