<widgets:WidgetBase x:Class="EveDashboard.App.Wpf.Reporting.Lifetime.LifetimeSummaryView"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:widgets="clr-namespace:EveDashboard.App.Wpf.Widgets"
                    mc:Ignorable="d">
    <!--
        Plan 46: the empty-selection lifetime rollup. Shown in the Reports right
        pane when no session is checked. "Lifetime Totals" header + a two-column
        Time/ISK block + a Total Refined Output table (Material | Quantity | ISK).
        Mirrors CompareSessionView (WidgetBase chrome + the same DataGrid chrome).
    -->
    <StackPanel Orientation="Vertical">
        <TextBlock Text="Lifetime Totals"
                   FontWeight="Bold"
                   FontSize="14"
                   Margin="0,0,0,2"
                   Foreground="{DynamicResource ForegroundBrush}" />
        <Separator Margin="0,0,0,8" />

        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0"
                       Text="Time Tracked:"
                       Margin="0,0,12,2"
                       Foreground="{DynamicResource ForegroundBrush}" />
            <TextBlock Grid.Row="0" Grid.Column="1"
                       Text="{Binding TimeTrackedDisplay}"
                       Margin="0,0,0,2"
                       Foreground="{DynamicResource ForegroundBrush}" />

            <TextBlock Grid.Row="1" Grid.Column="0"
                       Text="Total ISK:"
                       Margin="0,0,12,0"
                       Foreground="{DynamicResource ForegroundBrush}" />
            <TextBlock Grid.Row="1" Grid.Column="1"
                       Text="{Binding TotalIskDisplay}"
                       Foreground="{DynamicResource ForegroundBrush}" />
        </Grid>

        <TextBlock Text="Total Refined Output"
                   FontWeight="SemiBold"
                   Margin="0,0,0,2"
                   Foreground="{DynamicResource ForegroundBrush}" />

        <DataGrid x:Name="RefinedGrid"
                  ItemsSource="{Binding RefinedRows}"
                  AutoGenerateColumns="False"
                  CanUserSortColumns="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserReorderColumns="False"
                  CanUserResizeRows="False"
                  IsReadOnly="True"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  Background="Transparent"
                  Foreground="{DynamicResource ForegroundBrush}"
                  RowBackground="Transparent"
                  AlternatingRowBackground="{DynamicResource HoverOverlayBrush}"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Disabled"
                  PreviewMouseWheel="RefinedGrid_PreviewMouseWheel">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Material"
                                    Binding="{Binding Name}"
                                    Width="*"
                                    SortMemberPath="Name" />
                <DataGridTextColumn Header="Quantity"
                                    Binding="{Binding Quantity, StringFormat=N0}"
                                    Width="Auto"
                                    SortMemberPath="Quantity">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right" />
                            <Setter Property="Margin" Value="0,0,8,0" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Total ISK"
                                    Binding="{Binding Isk, StringFormat=N0}"
                                    Width="Auto"
                                    SortMemberPath="Isk">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right" />
                            <Setter Property="Margin" Value="0,0,8,0" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
    </StackPanel>
</widgets:WidgetBase>
