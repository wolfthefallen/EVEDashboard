<widgets:WidgetBase x:Class="EveDashboard.App.Wpf.Reporting.Lifetime.LifetimeSummaryView"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:widgets="clr-namespace:EveDashboard.App.Wpf.Widgets"
                    mc:Ignorable="d">
    <!--
        The all-time lifetime rollup widget, hosted by the Lifetime Totals
        window. "Lifetime Totals" header + a two-column Time/ISK block + a
        Total Refined Output table (Material | Quantity | ISK). Mirrors
        CompareSessionView (WidgetBase chrome + the same DataGrid chrome).
    -->
    <StackPanel Orientation="Vertical">
        <TextBlock Text="Lifetime Totals"
                   Tag="{Binding [Title]}"
                   Style="{StaticResource ReportsEmphasisLabel}"
                   Margin="0,0,0,2" />
        <Separator Margin="0,0,0,8" />

        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0"
                       Text="Time Tracked:"
                       Tag="{Binding [TimeTracked]}"
                       Style="{StaticResource ReportsEmphasisLabel}"
                       Margin="0,0,12,2" />
            <TextBlock Grid.Row="0" Grid.Column="1"
                       Text="{Binding TimeTrackedDisplay}"
                       Tag="{Binding [TimeTracked]}"
                       Style="{StaticResource ReportsEmphasisLabel}"
                       Margin="0,0,0,2" />

            <TextBlock Grid.Row="1" Grid.Column="0"
                       Text="Total ISK:"
                       Tag="{Binding [TotalIsk]}"
                       Style="{StaticResource ReportsEmphasisLabel}"
                       Margin="0,0,12,0" />
            <TextBlock Grid.Row="1" Grid.Column="1"
                       Text="{Binding TotalIskDisplay}"
                       Tag="{Binding [TotalIsk]}"
                       Style="{StaticResource ReportsEmphasisLabel}" />
        </Grid>

        <TextBlock Text="Total Refined Output"
                   Tag="{Binding [RefinedLabel]}"
                   Style="{StaticResource ReportsEmphasisLabel}"
                   Margin="0,0,0,2" />

        <DataGrid x:Name="RefinedGrid"
                  ItemsSource="{Binding RefinedRows}"
                  FontSize="{Binding [Table], Converter={StaticResource EmphasisToFontSize}}"
                  AutoGenerateColumns="False"
                  CanUserSortColumns="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserReorderColumns="False"
                  CanUserResizeRows="False"
                  IsReadOnly="True"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  Background="Transparent"
                  Foreground="{DynamicResource ForegroundBrush}"
                  RowBackground="Transparent"
                  AlternatingRowBackground="{DynamicResource HoverOverlayBrush}"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Disabled"
                  PreviewMouseWheel="RefinedGrid_PreviewMouseWheel">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Material"
                                    Binding="{Binding Name}"
                                    Width="*"
                                    SortMemberPath="Name" />
                <DataGridTextColumn Header="Quantity"
                                    Binding="{Binding Quantity, StringFormat=N0}"
                                    Width="Auto"
                                    SortMemberPath="Quantity">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Left" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Total ISK"
                                    Binding="{Binding Isk, StringFormat=N0}"
                                    Width="Auto"
                                    SortMemberPath="Isk">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Left" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
    </StackPanel>
</widgets:WidgetBase>
