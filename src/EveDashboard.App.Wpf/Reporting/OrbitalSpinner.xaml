<UserControl x:Class="EveDashboard.App.Wpf.Reporting.OrbitalSpinner"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             IsHitTestVisible="False">
    <!--
        Plan 34 (revised): mining-barge orbital loading spinner. The asteroid
        is static in the centre; an outer Grid wraps the ship and is rotated
        0 -> 360 degrees by a Storyboard. Because the ship's TranslateTransform
        offsets it within the orbiting Grid's local coordinate space, the ship
        traces a circle around the asteroid AND its orientation rotates with
        the container so the laser-firing-right base orientation always points
        inward (toward the asteroid). The Storyboard targets RotateTransform.Angle
        (a Freezable DependencyProperty), so the animation runs on the WPF
        composition (render) thread — it keeps spinning smoothly even when
        the UI dispatcher is fully saturated.
    -->
    <UserControl.Resources>
        <!-- Decode at ~2x display width (90 -> 200, 70 -> 200) so the source
             1024x1024 PNGs don't sit in memory at 16x the size we actually
             need, and so the GPU samples from a small texture each frame
             instead of from the full-res source. CacheOption=OnLoad forces
             decoding at resource-load time so the spinner is ready to render
             the instant it becomes visible. -->
        <BitmapImage x:Key="AsteroidImage"
                     DecodePixelWidth="200"
                     CacheOption="OnLoad"
                     UriSource="pack://application:,,,/Assets/asteroid.png" />
        <BitmapImage x:Key="ShipImage"
                     DecodePixelWidth="200"
                     CacheOption="OnLoad"
                     UriSource="pack://application:,,,/Assets/mining_barge.png" />
        <Storyboard x:Key="OrbitStoryboard" RepeatBehavior="Forever">
            <!-- 2-second loop = ~180 deg/sec. Faster than the original 4s pace
                 (which felt sluggish per alpha-tester feedback) and brisker than
                 a typical material-design spinner (~1.5s). Each mid-load
                 microstutter now covers half the angular gap, making it less
                 perceptible. -->
            <DoubleAnimation
                Storyboard.TargetName="OrbitRotate"
                Storyboard.TargetProperty="Angle"
                From="0" To="360" Duration="0:0:2" />
        </Storyboard>
    </UserControl.Resources>
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="UserControl.Loaded">
            <BeginStoryboard Storyboard="{StaticResource OrbitStoryboard}" />
        </EventTrigger>
    </UserControl.Triggers>
    <Grid>
        <!-- Asteroid: static, centred. Sized to ~45% of the container so the
             orbital ring has clear room around it. CacheMode=BitmapCache
             rasterizes the asteroid once and lets the GPU blit the cached
             bitmap on every frame instead of re-rasterizing from source. -->
        <Image Source="{StaticResource AsteroidImage}"
               Width="90" Height="90"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               Stretch="Uniform"
               CacheMode="BitmapCache"
               RenderOptions.BitmapScalingMode="Linear" />

        <!-- Orbital container: rotates around the asteroid via a Freezable
             RotateTransform whose Angle is animated by the Storyboard above. -->
        <Grid RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <RotateTransform x:Name="OrbitRotate" Angle="0" />
            </Grid.RenderTransform>

            <!-- Ship: offset to the orbital radius via TranslateTransform.
                 The pre-rotation of 180 degrees flips the ship so its
                 laser-firing-right base orientation faces INWARD (toward
                 the asteroid) when at the 3 o'clock position; as OrbitRotate
                 spins, the ship rotates with it and continues to face inward
                 at every orbital position. CacheMode here is the critical
                 perf tweak: WPF rasterizes the ship-with-its-flip-and-offset
                 ONCE, then the parent Grid's render-thread rotation applies
                 to that cached bitmap layer on the GPU. No per-frame
                 re-rasterization of the source PNG. -->
            <Image Source="{StaticResource ShipImage}"
                   Width="70" Height="50"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Stretch="Uniform"
                   RenderTransformOrigin="0.5,0.5"
                   CacheMode="BitmapCache"
                   RenderOptions.BitmapScalingMode="Linear">
                <Image.RenderTransform>
                    <TransformGroup>
                        <RotateTransform Angle="180" />
                        <TranslateTransform X="75" Y="0" />
                    </TransformGroup>
                </Image.RenderTransform>
            </Image>
        </Grid>
    </Grid>
</UserControl>
