<UserControl x:Class="EveDashboard.App.Wpf.Widgets.StatConfig.TextSizePopupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:settings="clr-namespace:EveDashboard.Core.Settings.WidgetStats;assembly=EveDashboard.Core"
             mc:Ignorable="d"
             MinWidth="240" MaxWidth="320">

    <UserControl.Resources>
        <!-- Plan 47: same emphasis enum source as the stat-config popup. -->
        <ObjectDataProvider x:Key="EmphasisValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="settings:StatEmphasis" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <!-- One row per configurable element: live-previewed Label | emphasis ComboBox.
             The label is styled by its own Emphasis via the shared ReportsEmphasisLabel style,
             so the user sees the size/weight/accent exactly like the active-session cog preview. -->
        <DataTemplate x:Key="TextSizeRowTemplate">
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding Label}"
                           Tag="{Binding Emphasis}"
                           Style="{StaticResource ReportsEmphasisLabel}"
                           VerticalAlignment="Center" />
                <ComboBox Grid.Column="1"
                          Width="92"
                          Margin="6,0,0,0"
                          VerticalAlignment="Center"
                          ToolTip="Text size"
                          ItemsSource="{Binding Source={StaticResource EmphasisValues}}"
                          SelectedItem="{Binding Emphasis, Mode=TwoWay}" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Text size"
                   FontWeight="Bold"
                   FontSize="13"
                   Margin="0,0,0,6"
                   Foreground="{DynamicResource ForegroundBrush}" />

        <TextBlock Grid.Row="1"
                   Text="Pick an emphasis for each element."
                   FontSize="11"
                   Opacity="0.7"
                   Margin="0,0,0,6"
                   Foreground="{DynamicResource ForegroundBrush}" />

        <ItemsControl Grid.Row="2"
                      ItemsSource="{Binding Rows}"
                      ItemTemplate="{StaticResource TextSizeRowTemplate}" />

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,8,0,0">
            <Button Content="Apply"
                    Command="{Binding ApplyCommand}"
                    Width="72"
                    Height="24"
                    Margin="0,0,6,0"
                    Background="{DynamicResource ButtonBackgroundBrush}"
                    Foreground="{DynamicResource ButtonForegroundBrush}" />
            <Button Content="Close"
                    Command="{Binding CloseCommand}"
                    Width="72"
                    Height="24"
                    Background="{DynamicResource ButtonBackgroundBrush}"
                    Foreground="{DynamicResource ButtonForegroundBrush}" />
        </StackPanel>
    </Grid>
</UserControl>
