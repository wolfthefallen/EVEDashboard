<widgets:WidgetBase x:Class="EveDashboard.App.Wpf.Widgets.Session.SessionStatsView"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:widgets="clr-namespace:EveDashboard.App.Wpf.Widgets"
                    xmlns:statconfig="clr-namespace:EveDashboard.App.Wpf.Widgets.StatConfig"
                    mc:Ignorable="d">
    <!--
        The body is one ItemsControl bound to Stats (no hard-coded header
        TextBlocks or stat Grid). DisplaySessionName (default Header1 emphasis),
        TotalTimeMined (default Hero emphasis), and the numeric stats all flow
        as StatRowViewModel rows via the implicit DataTemplate in
        Themes/StatRowTemplates.xaml. WidgetBase chrome handles the LastUpdated
        line with Visibility bound to IsLastUpdatedVisible.
        The "Refined output" section renders below the stats.
    -->
    <StackPanel>
        <ItemsControl ItemsSource="{Binding Stats}" />
        <statconfig:RefinedOutputSectionView />
    </StackPanel>
</widgets:WidgetBase>
