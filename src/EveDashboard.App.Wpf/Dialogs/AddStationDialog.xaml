<Window x:Class="EveDashboard.App.Wpf.Dialogs.AddStationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add market station"
        Height="332" Width="432"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource BorderBrush}"
        Foreground="{DynamicResource ForegroundBrush}">
    <Border Margin="6"
            Background="{DynamicResource BackgroundBrush}"
            Effect="{DynamicResource ModalShadowEffect}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0"
                   Text="Station ID:"
                   VerticalAlignment="Center"
                   Margin="0,0,8,8"
                   Foreground="{DynamicResource ForegroundBrush}" />
        <TextBox Grid.Row="0" Grid.Column="1"
                 x:Name="StationIdBox"
                 Text="{Binding StationIdText, UpdateSourceTrigger=PropertyChanged}"
                 Margin="0,0,0,8"
                 Height="28" />

        <TextBlock Grid.Row="1" Grid.Column="0"
                   Text="System name:"
                   VerticalAlignment="Center"
                   Margin="0,0,8,8"
                   Foreground="{DynamicResource ForegroundBrush}" />
        <TextBox Grid.Row="1" Grid.Column="1"
                 x:Name="SystemNameBox"
                 Text="{Binding SystemName, UpdateSourceTrigger=PropertyChanged}"
                 Margin="0,0,0,8"
                 Height="28" />

        <TextBlock Grid.Row="2" Grid.Column="0"
                   Text="Station name:"
                   VerticalAlignment="Center"
                   Margin="0,0,8,8"
                   Foreground="{DynamicResource ForegroundBrush}" />
        <TextBox Grid.Row="2" Grid.Column="1"
                 x:Name="StationNameBox"
                 Text="{Binding StationName, UpdateSourceTrigger=PropertyChanged}"
                 Margin="0,0,0,8"
                 Height="28" />

        <TextBlock Grid.Row="3" Grid.Column="0"
                   Text="Region ID:"
                   VerticalAlignment="Center"
                   Margin="0,0,8,8"
                   Foreground="{DynamicResource ForegroundBrush}" />
        <TextBox Grid.Row="3" Grid.Column="1"
                 x:Name="RegionIdBox"
                 Text="{Binding RegionIdText, UpdateSourceTrigger=PropertyChanged}"
                 Margin="0,0,0,8"
                 Height="28" />

        <TextBlock Grid.Row="4" Grid.Column="0"
                   Text="Region name:"
                   VerticalAlignment="Center"
                   Margin="0,0,8,8"
                   Foreground="{DynamicResource ForegroundBrush}" />
        <TextBox Grid.Row="4" Grid.Column="1"
                 x:Name="RegionNameBox"
                 Text="{Binding RegionName, UpdateSourceTrigger=PropertyChanged}"
                 Margin="0,0,0,8"
                 Height="28" />

        <StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button x:Name="CancelButton"
                    Content="Cancel"
                    IsCancel="True"
                    Width="84"
                    Height="28"
                    Margin="0,0,8,0"
                    Background="{DynamicResource ButtonBackgroundBrush}"
                    Foreground="{DynamicResource ButtonForegroundBrush}"
                    Click="CancelButton_Click" />
            <Button x:Name="OkButton"
                    Content="OK"
                    IsDefault="True"
                    Width="84"
                    Height="28"
                    Background="{DynamicResource ButtonBackgroundBrush}"
                    Foreground="{DynamicResource ButtonForegroundBrush}"
                    Click="OkButton_Click" />
        </StackPanel>
    </Grid>
    </Border>
</Window>
