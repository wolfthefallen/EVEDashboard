<Window x:Class="EveDashboard.App.Wpf.Dialogs.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:settings="clr-namespace:EveDashboard.Core.Settings;assembly=EveDashboard.Core"
        xmlns:converters="clr-namespace:EveDashboard.App.Wpf.Converters"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="Settings"
        Height="660" Width="552"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="{DynamicResource BorderBrush}"
        Foreground="{DynamicResource ForegroundBrush}">
    <Window.Resources>
        <!-- Plan 22.2: BCL converter shows the banner when in bootstrap-failure mode;
             custom inverse hides Display / Pricing / Markets in the same mode. -->
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
    </Window.Resources>

    <Border Margin="6"
            Background="{DynamicResource BackgroundBrush}"
            Effect="{DynamicResource ModalShadowEffect}">
        <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Plan 22.2: bootstrap-failure banner. Visible only when
             IsBootstrapFailureMode is true; renders BannerMessage. -->
        <Border Grid.Row="0"
                Background="{DynamicResource StatusErrorBrush}"
                Padding="12,8"
                Margin="0,0,0,12"
                Visibility="{Binding IsBootstrapFailureMode, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="{Binding BannerMessage}"
                       Foreground="{DynamicResource ForegroundBrush}"
                       TextWrapping="Wrap"
                       FontWeight="SemiBold" />
        </Border>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <!-- ============================================== Display ============================================== -->
                <!-- Plan 22.2: section hidden in bootstrap-failure mode. -->
                <StackPanel Visibility="{Binding IsBootstrapFailureMode, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <TextBlock Text="Display"
                               FontSize="16"
                               FontWeight="Bold"
                               Margin="0,0,0,8"
                               Foreground="{DynamicResource ForegroundBrush}" />
                    <Grid Margin="12,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="Theme:"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource ForegroundBrush}" />
                        <ComboBox Grid.Column="1"
                                  x:Name="ThemeCombo"
                                  ItemsSource="{Binding ThemeOptions}"
                                  SelectedItem="{Binding Theme, Mode=TwoWay}"
                                  Height="24" />
                    </Grid>
                </StackPanel>

                <!-- ============================================== Pricing ============================================== -->
                <!-- Plan 22.2: section hidden in bootstrap-failure mode. -->
                <StackPanel Visibility="{Binding IsBootstrapFailureMode, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <TextBlock Text="Pricing"
                               FontSize="16"
                               FontWeight="Bold"
                               Margin="0,0,0,8"
                               Foreground="{DynamicResource ForegroundBrush}" />
                    <Grid Margin="12,0,0,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="Refining yield %:"
                                   VerticalAlignment="Center"
                                   Margin="0,0,0,8"
                                   Foreground="{DynamicResource ForegroundBrush}" />
                        <TextBox Grid.Row="0" Grid.Column="1"
                                 x:Name="RefiningYieldBox"
                                 Text="{Binding RefiningYieldText, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,8"
                                 Height="28" />

                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Text="Price mode:"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource ForegroundBrush}" />
                        <ComboBox Grid.Row="1" Grid.Column="1"
                                  x:Name="PriceModeCombo"
                                  ItemsSource="{Binding PriceModeOptions}"
                                  SelectedItem="{Binding PriceMode, Mode=TwoWay}"
                                  Height="24" />
                    </Grid>
                </StackPanel>

                <!-- ============================================== Markets ============================================== -->
                <!-- Plan 22.2: section hidden in bootstrap-failure mode. -->
                <StackPanel Visibility="{Binding IsBootstrapFailureMode, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <TextBlock Text="Markets"
                               FontSize="16"
                               FontWeight="Bold"
                               Margin="0,0,0,8"
                               Foreground="{DynamicResource ForegroundBrush}" />
                    <Grid Margin="12,0,0,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="Selected station:"
                                   VerticalAlignment="Center"
                                   Margin="0,0,0,8"
                                   Foreground="{DynamicResource ForegroundBrush}" />
                        <ComboBox Grid.Row="0" Grid.Column="1"
                                  x:Name="SelectedStationCombo"
                                  ItemsSource="{Binding Stations}"
                                  SelectedValue="{Binding SelectedStationId, Mode=TwoWay}"
                                  SelectedValuePath="StationId"
                                  Margin="0,0,0,8"
                                  Height="24">
                            <ComboBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type settings:MarketStation}">
                                    <TextBlock>
                                        <Run Text="{Binding SystemName, Mode=OneWay}" />
                                        <Run Text=" - " />
                                        <Run Text="{Binding StationName, Mode=OneWay}" />
                                    </TextBlock>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Text="Stations:"
                                   VerticalAlignment="Top"
                                   Margin="0,4,0,8"
                                   Foreground="{DynamicResource ForegroundBrush}" />
                        <ListBox Grid.Row="1" Grid.Column="1"
                                 x:Name="StationsList"
                                 ItemsSource="{Binding Stations}"
                                 Height="120"
                                 Margin="0,0,0,8"
                                 Background="{DynamicResource WidgetBackgroundBrush}"
                                 Foreground="{DynamicResource ForegroundBrush}"
                                 BorderBrush="{DynamicResource WidgetBorderBrush}">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type settings:MarketStation}">
                                    <TextBlock>
                                        <Run Text="{Binding SystemName, Mode=OneWay}" />
                                        <Run Text=" - " />
                                        <Run Text="{Binding StationName, Mode=OneWay}" />
                                    </TextBlock>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel Grid.Row="2" Grid.Column="1"
                                    Orientation="Horizontal"
                                    Margin="0,0,0,8">
                            <Button x:Name="AddStationButton"
                                    Content="Add station"
                                    Width="110"
                                    Height="24"
                                    Margin="0,0,8,0"
                                    Command="{Binding AddStationCommand}"
                                    Background="{DynamicResource ButtonBackgroundBrush}"
                                    Foreground="{DynamicResource ButtonForegroundBrush}" />
                            <Button x:Name="RemoveStationButton"
                                    Content="Remove station"
                                    Width="130"
                                    Height="24"
                                    Command="{Binding RemoveStationCommand}"
                                    CommandParameter="{Binding SelectedItem, ElementName=StationsList}"
                                    Background="{DynamicResource ButtonBackgroundBrush}"
                                    Foreground="{DynamicResource ButtonForegroundBrush}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!-- ============================================== Auto-pause ============================================== -->
                <!-- Plan 37: section hidden in bootstrap-failure mode. -->
                <StackPanel Visibility="{Binding IsBootstrapFailureMode, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <TextBlock Text="Auto-pause"
                               FontSize="16"
                               FontWeight="Bold"
                               Margin="0,0,0,8"
                               Foreground="{DynamicResource ForegroundBrush}" />
                    <Grid Margin="12,0,0,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="Idle minutes before auto-pause:"
                                   VerticalAlignment="Center"
                                   Margin="0,0,0,8"
                                   Foreground="{DynamicResource ForegroundBrush}" />
                        <TextBox Grid.Row="0" Grid.Column="1"
                                 x:Name="AutoPauseIdleMinutesBox"
                                 Text="{Binding AutoPauseIdleMinutesText, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,8"
                                 Height="28" />

                        <CheckBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                  x:Name="AutoPauseSoundCheck"
                                  Content="Play sounds on auto-pause / auto-resume"
                                  IsChecked="{Binding AutoPauseSoundEnabled, Mode=TwoWay}"
                                  Foreground="{DynamicResource ForegroundBrush}" />

                        <!-- Plan 50: notification volume. Disabled (greyed) while the
                             sound checkbox above is unchecked (decision 5.2 = A). -->
                        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                    Orientation="Horizontal"
                                    Margin="0,8,0,0"
                                    IsEnabled="{Binding AutoPauseSoundEnabled}">
                            <TextBlock Text="Volume:"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"
                                       Foreground="{DynamicResource ForegroundBrush}" />
                            <Slider x:Name="AutoPauseSoundVolumeSlider"
                                    Width="200"
                                    Minimum="0" Maximum="100"
                                    TickFrequency="5" IsSnapToTickEnabled="True"
                                    VerticalAlignment="Center"
                                    Value="{Binding AutoPauseSoundVolume, Mode=TwoWay}" />
                            <TextBlock VerticalAlignment="Center"
                                       Margin="8,0,0,0"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Text="{Binding AutoPauseSoundVolume, StringFormat={}{0}%}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!-- ============================================== Refined output ============================================== -->
                <!-- Plan 43: section hidden in bootstrap-failure mode. -->
                <StackPanel Visibility="{Binding IsBootstrapFailureMode, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <TextBlock Text="Refined output"
                               FontSize="16"
                               FontWeight="Bold"
                               Margin="0,0,0,8"
                               Foreground="{DynamicResource ForegroundBrush}" />
                    <CheckBox x:Name="AutoShowRefinedMaterialsCheck"
                              Margin="12,0,0,4"
                              Content="Auto-show refined materials as they are mined"
                              IsChecked="{Binding AutoShowRefinedMaterials, Mode=TwoWay}"
                              Foreground="{DynamicResource ForegroundBrush}" />
                    <CheckBox x:Name="ShowPilotRefinedOutputCheck"
                              Margin="12,0,0,16"
                              Content="Show refined output on pilot widgets"
                              IsChecked="{Binding ShowPilotRefinedOutput, Mode=TwoWay}"
                              Foreground="{DynamicResource ForegroundBrush}" />
                </StackPanel>

                <!-- ============================================== Logs ============================================== -->
                <TextBlock Text="Logs"
                           FontSize="16"
                           FontWeight="Bold"
                           Margin="0,0,0,8"
                           Foreground="{DynamicResource ForegroundBrush}" />
                <Grid Margin="12,0,0,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0"
                               Text="Gamelog folder:"
                               VerticalAlignment="Center"
                               Margin="0,0,0,8"
                               Foreground="{DynamicResource ForegroundBrush}" />
                    <TextBox Grid.Row="0" Grid.Column="1"
                             x:Name="GamelogPathBox"
                             Text="{Binding GamelogPath, UpdateSourceTrigger=PropertyChanged}"
                             VerticalAlignment="Center"
                             Margin="0,0,8,8"
                             Height="28" />
                    <Button Grid.Row="0" Grid.Column="2"
                            x:Name="BrowseButton"
                            Content="Browse..."
                            Width="84"
                            Height="24"
                            Margin="0,0,0,8"
                            Command="{Binding BrowseGamelogCommand}"
                            Background="{DynamicResource ButtonBackgroundBrush}"
                            Foreground="{DynamicResource ButtonForegroundBrush}" />
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button x:Name="ApplyButton"
                    Content="Apply"
                    Width="84"
                    Height="28"
                    Margin="0,0,8,0"
                    Click="ApplyButton_Click"
                    Background="{DynamicResource ButtonBackgroundBrush}"
                    Foreground="{DynamicResource ButtonForegroundBrush}" />
            <Button x:Name="CloseButton"
                    Content="Close"
                    IsCancel="True"
                    Width="84"
                    Height="28"
                    Click="CloseButton_Click"
                    Background="{DynamicResource ButtonBackgroundBrush}"
                    Foreground="{DynamicResource ButtonForegroundBrush}" />
        </StackPanel>
        </Grid>
    </Border>
</Window>
