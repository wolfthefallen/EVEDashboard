<Window x:Class="EveDashboard.App.Wpf.Dialogs.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="192" Width="452"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource BorderBrush}"
        Foreground="{DynamicResource ForegroundBrush}">
    <!-- Title, body, and button labels are set by the adapter via the
         constructor before ShowDialog. -->
    <Border Margin="6"
            Background="{DynamicResource BackgroundBrush}"
            Effect="{DynamicResource ModalShadowEffect}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="BodyTextBlock"
                   Grid.Row="0"
                   TextWrapping="Wrap"
                   VerticalAlignment="Center"
                   FontSize="14"
                   Foreground="{DynamicResource ForegroundBrush}" />

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button x:Name="CancelButton"
                    IsCancel="True"
                    Width="84"
                    Height="28"
                    Margin="0,0,8,0"
                    Background="{DynamicResource ButtonBackgroundBrush}"
                    Foreground="{DynamicResource ButtonForegroundBrush}"
                    Click="CancelButton_Click" />
            <Button x:Name="ConfirmButton"
                    IsDefault="True"
                    Width="84"
                    Height="28"
                    Background="{DynamicResource ButtonBackgroundBrush}"
                    Foreground="{DynamicResource ButtonForegroundBrush}"
                    Click="ConfirmButton_Click" />
        </StackPanel>
    </Grid>
    </Border>
</Window>
