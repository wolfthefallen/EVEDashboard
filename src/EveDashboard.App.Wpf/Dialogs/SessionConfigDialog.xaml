<Window x:Class="EveDashboard.App.Wpf.Dialogs.SessionConfigDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:EveDashboard.App.Wpf.Converters"
        Title="New Mining Session"
        Height="560" Width="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="{DynamicResource BorderBrush}"
        Foreground="{DynamicResource ForegroundBrush}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
        <converters:StringEmptyToVisibilityConverter x:Key="StringEmptyToVis" />
        <converters:PilotSortOrderLabelConverter x:Key="SortLabel" />
    </Window.Resources>
    <Border Margin="6"
            Background="{DynamicResource BackgroundBrush}"
            Effect="{DynamicResource ModalShadowEffect}">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="Start a new mining session"
                       FontSize="16" FontWeight="Bold"
                       Margin="0,0,0,12"
                       Foreground="{DynamicResource ForegroundBrush}" />

            <StackPanel Grid.Row="1" Margin="0,0,0,12">
                <TextBlock Text="Session name (use {{$DATE}}, {{$TIME}}, {{$DATETIME}}, {{$CHARS}}, {{$STARTDATE}}, {{$YYYY}})"
                           FontSize="11" Margin="0,0,0,2" Opacity="0.7"
                           Foreground="{DynamicResource ForegroundBrush}" />
                <TextBox Text="{Binding SessionName, UpdateSourceTrigger=PropertyChanged}"
                         Padding="4,2" />
            </StackPanel>

            <!-- ===== Main content: fleet list OR create-fleet flow ===== -->
            <Grid Grid.Row="3">

                <!-- Fleet list mode -->
                <DockPanel Visibility="{Binding IsCreatingFleet, Converter={StaticResource InverseBoolToVis}}">
                    <TextBlock DockPanel.Dock="Top"
                               Text="Fleets"
                               FontWeight="Bold"
                               Margin="0,0,0,4"
                               Foreground="{DynamicResource ForegroundBrush}" />

                    <Button DockPanel.Dock="Bottom"
                            Content="Create Fleet"
                            Height="28"
                            Margin="0,8,0,0"
                            HorizontalAlignment="Left"
                            Padding="12,0"
                            Background="{DynamicResource ButtonBackgroundBrush}"
                            Foreground="{DynamicResource ButtonForegroundBrush}"
                            Command="{Binding CreateFleetCommand}" />

                    <TextBlock DockPanel.Dock="Top"
                               Text="No fleets yet. Click Create Fleet to make one — a fleet is how you start a session."
                               TextWrapping="Wrap"
                               Opacity="0.7"
                               Margin="0,4,0,0"
                               Foreground="{DynamicResource ForegroundBrush}"
                               Visibility="{Binding HasNoFleets, Converter={StaticResource BoolToVis}}" />

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Fleets}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Expander IsExpanded="{Binding IsExpanded}"
                                              Margin="0,2"
                                              Background="{DynamicResource BorderBrush}"
                                              Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                        <Expander.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Make default"
                                                          Command="{Binding PlacementTarget.Tag.MakeDefaultCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                <MenuItem Header="Delete"
                                                          Command="{Binding PlacementTarget.Tag.DeleteFleetCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            </ContextMenu>
                                        </Expander.ContextMenu>
                                        <Expander.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <CheckBox IsChecked="{Binding IsSelected}"
                                                          Content="{Binding Name}"
                                                          VerticalAlignment="Center"
                                                          Foreground="{DynamicResource ForegroundBrush}" />
                                                <TextBlock Text="(default)"
                                                           Margin="8,0,0,0"
                                                           VerticalAlignment="Center"
                                                           FontSize="11" Opacity="0.7"
                                                           Foreground="{DynamicResource ForegroundBrush}"
                                                           Visibility="{Binding IsDefault, Converter={StaticResource BoolToVis}}" />
                                            </StackPanel>
                                        </Expander.Header>
                                        <ItemsControl ItemsSource="{Binding MemberLines}"
                                                      Margin="24,2,0,4">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}"
                                                               FontSize="11" Opacity="0.85"
                                                               Foreground="{DynamicResource ForegroundBrush}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>

                <!-- Create-fleet flow -->
                <Grid Visibility="{Binding IsCreatingFleet, Converter={StaticResource BoolToVis}}">

                    <!-- Pilot picker (before Add Fleet) -->
                    <DockPanel Visibility="{Binding IsConfirmingFleet, Converter={StaticResource InverseBoolToVis}}">
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="Sort by"
                                       VerticalAlignment="Center"
                                       Margin="0,0,6,0"
                                       Foreground="{DynamicResource ForegroundBrush}" />
                            <ComboBox Grid.Column="1"
                                      HorizontalAlignment="Left"
                                      Width="180"
                                      ItemsSource="{Binding SortOptions}"
                                      SelectedItem="{Binding SortOrder}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource SortLabel}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>

                        <StackPanel DockPanel.Dock="Bottom"
                                    Orientation="Horizontal"
                                    Margin="0,8,0,0">
                            <Button Content="Add Fleet"
                                    Height="28" Padding="12,0"
                                    Margin="0,0,8,0"
                                    Background="{DynamicResource ButtonBackgroundBrush}"
                                    Foreground="{DynamicResource ButtonForegroundBrush}"
                                    Command="{Binding AddFleetCommand}" />
                            <Button Content="Cancel"
                                    Height="28" Padding="12,0"
                                    Background="{DynamicResource ButtonBackgroundBrush}"
                                    Foreground="{DynamicResource ButtonForegroundBrush}"
                                    Command="{Binding CancelCreateCommand}" />
                        </StackPanel>

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding PilotPicker}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Grid.Column="0"
                                                      Content="{Binding Character.Name}"
                                                      IsChecked="{Binding IsSelected}"
                                                      VerticalAlignment="Center"
                                                      Foreground="{DynamicResource ForegroundBrush}" />
                                            <ComboBox Grid.Column="1"
                                                      Width="110"
                                                      ItemsSource="{Binding DataContext.RoleOptions, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                      SelectedItem="{Binding Role}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>

                    <!-- Confirm / name panel (after Add Fleet) -->
                    <DockPanel Visibility="{Binding IsConfirmingFleet, Converter={StaticResource BoolToVis}}">
                        <TextBlock DockPanel.Dock="Top"
                                   Text="Name this fleet"
                                   FontWeight="Bold"
                                   Margin="0,0,0,6"
                                   Foreground="{DynamicResource ForegroundBrush}" />

                        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                            <TextBlock Text="{Binding SaveError}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,6"
                                       Foreground="#FFCC4444"
                                       Visibility="{Binding SaveError, Converter={StaticResource StringEmptyToVis}}" />
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Save"
                                        Height="28" Padding="12,0"
                                        Margin="0,0,8,0"
                                        Background="{DynamicResource ButtonBackgroundBrush}"
                                        Foreground="{DynamicResource ButtonForegroundBrush}"
                                        Command="{Binding SaveFleetCommand}" />
                                <Button Content="Cancel"
                                        Height="28" Padding="12,0"
                                        Background="{DynamicResource ButtonBackgroundBrush}"
                                        Foreground="{DynamicResource ButtonForegroundBrush}"
                                        Command="{Binding CancelCreateCommand}" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                            <TextBox Text="{Binding NewFleetName, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="4,2" Margin="0,0,0,6" />
                            <CheckBox Content="Make default fleet"
                                      IsChecked="{Binding MakeDefault}"
                                      Foreground="{DynamicResource ForegroundBrush}" />
                        </StackPanel>

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding ConfirmedRoster}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}"
                                                   FontSize="12" Margin="0,1"
                                                   Foreground="{DynamicResource ForegroundBrush}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Grid>
            </Grid>

            <!-- Start error (no discoverable pilots) -->
            <TextBlock Grid.Row="4"
                       Text="{Binding StartError}"
                       TextWrapping="Wrap"
                       Margin="0,8,0,0"
                       Foreground="#FFCC4444"
                       Visibility="{Binding StartError, Converter={StaticResource StringEmptyToVis}}" />

            <StackPanel Grid.Row="5"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,16,0,0">
                <Button x:Name="CancelButton"
                        Content="Cancel"
                        IsCancel="True"
                        Width="84" Height="28"
                        Margin="0,0,8,0"
                        Background="{DynamicResource ButtonBackgroundBrush}"
                        Foreground="{DynamicResource ButtonForegroundBrush}"
                        Command="{Binding CancelCommand}" />
                <Button x:Name="StartButton"
                        Content="Start"
                        IsDefault="True"
                        Width="84" Height="28"
                        Background="{DynamicResource ButtonBackgroundBrush}"
                        Foreground="{DynamicResource ButtonForegroundBrush}"
                        Command="{Binding StartCommand}" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
